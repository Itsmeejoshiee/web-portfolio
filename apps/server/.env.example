# Postgres connection string (defaults to the local Docker Compose Postgres for dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/web_portfolio_dev

# Port the NestJS server listens on
PORT=3001

# Allowed CORS origin — the deployed/local frontend's URL
WEB_ORIGIN=http://localhost:5173

# GitHub OAuth App credentials (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Secret used to sign admin session JWTs — generate with `openssl rand -hex 32`
JWT_SECRET=

# Your GitHub numeric user ID — only this account is allowed to authenticate as admin
# Find it at https://api.github.com/users/<your-username>
OWNER_GITHUB_ID=
